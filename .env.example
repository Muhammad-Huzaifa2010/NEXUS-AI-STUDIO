# Required: create a Groq API key in your Groq account and keep it private.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Database credentials. Use a long URL-safe password (letters and numbers).
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=CHANGE_ME


# Local/private default. For a VPS reverse proxy, keep APP_BIND=127.0.0.1.
APP_BIND=127.0.0.1
APP_PORT=8080
PUBLIC_URL=http://localhost:8080

# Optional live web research.
# Leave empty to disable Tavily-backed research.
TAVILY_API_KEY=replace_with_your_tavily_api_key

# For HTTPS deployment with docker-compose.prod.yml, set your DNS name.
# DOMAIN=nexus.example.com
