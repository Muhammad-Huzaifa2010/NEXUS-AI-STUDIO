# AI provider configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional live web research
TAVILY_API_KEY=your_tavily_api_key_here

# Citation correction retries (0-3)
CITATION_VALIDATION_RETRIES=1

# Bounded research retrieval limits
RESEARCH_SEARCH_BUDGET=5
RESEARCH_RESULTS_PER_QUERY=5
RESEARCH_MAX_SOURCES=6

# Optional for local PostgreSQL task history
# DATABASE_URL=postgresql://nexus:password@localhost:5432/nexus

# Frontend origin allowed by the local backend
FRONTEND_URL=http://localhost:5173